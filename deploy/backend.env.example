ENVIRONMENT=production

# MySQL address reachable from the backend container.
DATABASE_URL=mysql+pymysql://contract_user:CHANGE_ME@mysql.example.internal:3306/contract_review?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=120
DB_POOL_PRE_PING=true
AUTH_CACHE_SECONDS=60

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=720

# This password is used only when the database has no users yet. Set it before
# the first startup; changing it later does not overwrite existing users.
DEMO_MODE=false
INITIAL_PASSWORD=CHANGE_TO_A_STRONG_INITIAL_PASSWORD

# Master Cat uses a server-side plugin proxy, so CORS is not required for the
# plugin itself. Keep only origins that should access the API from a browser.
CORS_ORIGINS=https://contracts.example.com

SSO_ENABLED=false

LLM_API_URL=https://newapi.example.com
LLM_API_KEY=CHANGE_ME
LLM_MODEL=your-contract-review-model
