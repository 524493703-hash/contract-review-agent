# Backend
ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://contract_user:CHANGE_ME@mysql.example.internal:3306/contract_review_poc?charset=utf8mb4
# Used only by scripts/live_acceptance.py. It is reset before every full run.
TEST_DATABASE_NAME=contract_review_test
# Remote MySQL performance tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=120
DB_POOL_PRE_PING=false
AUTH_CACHE_SECONDS=60
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=720

# Used only when the database has no users yet. Change both values before the
# first production start. Password changes here do not overwrite existing users.
DEMO_MODE=false
INITIAL_PASSWORD=CHANGE_TO_A_STRONG_INITIAL_PASSWORD
CORS_ORIGINS=https://contracts.example.com

# DeepSeek official OpenAI-compatible API
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-v4-pro
# Optional: use a separate DeepSeek model for focused-check adjudication.
# When empty, focused-check adjudication uses LLM_MODEL.
FOCUSED_CHECK_MODEL=deepseek-v4-pro
# active: legacy regex findings are user-visible; shadow: recall hints only;
# disabled: do not execute legacy regex rules.
LEGACY_RULE_MODE=shadow

# Optional enterprise integration switches
SSO_ENABLED=false
